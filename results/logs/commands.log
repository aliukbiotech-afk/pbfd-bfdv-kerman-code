Step 30.generationsAtCurrentBest_cAIC=0;

Step 31.generationsNoNewModelsAdded=0;

Step 32.parentModels=gard.GA.initializeModels(numberOfBreakPointsBeingEvaluated,populationSize,numberOfPotentialBreakPoints,bestOverallModelSoFar);

Step 33.terminationCondition=FALSE;

Step 34.generation=0;

Step 35.previousBest_cAIC=^"math.Infinity";

Step 36.Branch under condition 'terminationCondition==FALSE'
	to
		childModels=gard.GA.recombineModels(parentModels,populationSize);
	else
		io.ClearProgressBar();

Step 37.childModels=gard.GA.recombineModels(parentModels,populationSize);

Step 38.interGenerationalModels=parentModels;

Step 39.interGenerationalModels*childModels;

Step 40.gard.GA.evaluateModels(interGenerationalModels);

Step 41.selectedModels=gard.GA.selectModels(interGenerationalModels,populationSize);

Step 42.Branch under condition 'gard.GA.modelSetsAreTheSame(selectedModels,parentModels)'
	to
		generationsNoNewModelsAdded+=1;
	else
		generationsNoNewModelsAdded=0;

Step 43.generationsNoNewModelsAdded+=1;

Step 44.Go to step 46

Step 45.generationsNoNewModelsAdded=0;

Step 46.currentBest_individual=Min(interGenerationalModels,1);

Step 47.currentBest_cAIC=currentBest_individual["value"];

Step 48.currentBest_model=Eval(currentBest_individual["key"]);

Step 49.Branch under condition '(math.minNormalizedRange(selectedModels)<cAIC_diversityThreshold)||(generationsNoNewModelsAdded>maxGenerationsAllowedWithNoNewModelsAdded)'
	to
		parentModels=gard.GA.generateNewGenerationOfModelsByMutatingModelSet(selectedModels,numberOfPotentialBreakPoints,mutationRate,rateOfMutationsTharAreSmallShifts);
	else
		parentModels=selectedModels;

Step 50.parentModels=gard.GA.generateNewGenerationOfModelsByMutatingModelSet(selectedModels,numberOfPotentialBreakPoints,mutationRate,rateOfMutationsTharAreSmallShifts);

Step 51.Branch under condition 'Abs(parentModels)==1'
	to
		parentModels=gard.GA.initializeModels(numberOfBreakPointsBeingEvaluated,populationSize-1,numberOfPotentialBreakPoints,bestOverallModelSoFar);
	else
		differenceThreshold=numberOfBreakPointsBeingEvaluated/4;

Step 52.parentModels=gard.GA.initializeModels(numberOfBreakPointsBeingEvaluated,populationSize-1,numberOfPotentialBreakPoints,bestOverallModelSoFar);

Step 53.parentModels[currentBest_model]=currentBest_cAIC;

Step 54.differenceThreshold=numberOfBreakPointsBeingEvaluated/4;

Step 55.Go to step 57

Step 56.parentModels=selectedModels;

Step 57.Branch under condition 'previousBest_cAIC-currentBest_cAIC<cAIC_improvementThreshold'
	to
		generationsAtCurrentBest_cAIC+=1;
	else
		generationsAtCurrentBest_cAIC=0;

Step 58.generationsAtCurrentBest_cAIC+=1;

Step 59.Branch under condition 'generationsAtCurrentBest_cAIC>=maxGenerationsAllowedAtStagnant_cAIC'
	to
		terminationCondition=TRUE;
	else
		Go to step 63

Step 60.terminationCondition=TRUE;

Step 61.Go to step 63

Step 62.generationsAtCurrentBest_cAIC=0;

Step 63.Branch under condition 'previousBest_cAIC>0&&previousBest_cAIC<currentBest_cAIC'
	to
		io.CheckAssertion("gard.previousBest_cAIC >= gard.currentBest_cAIC","Internal error in GARD -- c-AIC INCREASED between two consecutive generations");
	else
		previousBest_cAIC=currentBest_cAIC;

Step 64.io.CheckAssertion("gard.previousBest_cAIC >= gard.currentBest_cAIC","Internal error in GARD -- c-AIC INCREASED between two consecutive generations");

Step 65.previousBest_cAIC=currentBest_cAIC;

Step 66.generation+=1;

Step 67.Branch under condition 'bestOverall_cAIC_soFar-currentBest_cAIC>0'
	to
		io.ReportProgressBar("GARD",Format(numberOfBreakPointsBeingEvaluated,3,0)+' breakpoints [ generation '+Format(generation,6,0)+", total models "+Format(Abs(masterList),8,0)+", "+Format(generationsAtCurrentBest_cAIC/maxGenerationsAllowedAtStagnant_cAIC*100,4,0)+"% converged, "+Format(Abs(masterList)/(Time(1)-startTime),5,2)+"/sec]"+". Min (c-AIC) = "+Format(currentBest_cAIC,12,4)+" [ delta = "+Format(bestOverall_cAIC_soFar-currentBest_cAIC,8,2)+"], breakpoints at "+Join(", ",currentBest_model));
	else
		io.ReportProgressBar("GARD",Format(numberOfBreakPointsBeingEvaluated,3,0)+' breakpoints [ generation '+Format(generation,6,0)+", total models "+Format(Abs(masterList),8,0)+", "+Format(generationsAtCurrentBest_cAIC/maxGenerationsAllowedAtStagnant_cAIC*100,4,0)+"% converged, "+Format(Abs(masterList)/(Time(1)-startTime),5,2)+"/sec]"+". Min (c-AIC) = "+Format(currentBest_cAIC,12,4)+" [no improvement], breakpoints at "+Join(", ",currentBest_model));

Step 68.io.ReportProgressBar("GARD",Format(numberOfBreakPointsBeingEvaluated,3,0)+' breakpoints [ generation '+Format(generation,6,0)+", total models "+Format(Abs(masterList),8,0)+", "+Format(generationsAtCurrentBest_cAIC/maxGenerationsAllowedAtStagnant_cAIC*100,4,0)+"% converged, "+Format(Abs(masterList)/(Time(1)-startTime),5,2)+"/sec]"+". Min (c-AIC) = "+Format(currentBest_cAIC,12,4)+" [ delta = "+Format(bestOverall_cAIC_soFar-currentBest_cAIC,8,2)+"], breakpoints at "+Join(", ",currentBest_model));

Step 69.Go to step 71

Step 70.io.ReportProgressBar("GARD",Format(numberOfBreakPointsBeingEvaluated,3,0)+' breakpoints [ generation '+Format(generation,6,0)+", total models "+Format(Abs(masterList),8,0)+", "+Format(generationsAtCurrentBest_cAIC/maxGenerationsAllowedAtStagnant_cAIC*100,4,0)+"% converged, "+Format(Abs(masterList)/(Time(1)-startTime),5,2)+"/sec]"+". Min (c-AIC) = "+Format(currentBest_cAIC,12,4)+" [no improvement], breakpoints at "+Join(", ",currentBest_model));

Step 71.Go to step 36

Step 72.io.ClearProgressBar();

Step 73.statusString=("Done with "+numberOfBreakPointsBeingEvaluated+" breakpoint analysis.\n"+gard.GA.getMultiBreakPointStatusString(selectedModels,variableSiteMap));

Step 74.io.ReportProgressMessageMD('GARD','multi-breakpoint',statusString);

Step 75.Branch under condition 'previousBest_cAIC<bestOverall_cAIC_soFar'
	to
		bestModel=gard.Helper.convertMatrixStringToMatrix(utility.Keys(selectedModels)[Min(utility.Values(selectedModels),1)[1]]);
	else
		addingBreakPointsImproves_cAIC=FALSE;

Step 76.bestModel=gard.Helper.convertMatrixStringToMatrix(utility.Keys(selectedModels)[Min(utility.Values(selectedModels),1)[1]]);

Step 77.improvements[numberOfBreakPointsBeingEvaluated-1]={"deltaAICc":bestOverall_cAIC_soFar-previousBest_cAIC,"breakpoints":bestModel};

Step 78.bestOverall_cAIC_soFar=previousBest_cAIC;

Step 79.bestModel=gard.Helper.convertMatrixStringToMatrix(utility.Keys(selectedModels)[Min(utility.Values(selectedModels),1)[1]]);

Step 80.bestOverallModelSoFar=bestModel;

Step 81.Go to step 83

Step 82.addingBreakPointsImproves_cAIC=FALSE;

Step 83.gard.concludeAnalysis(bestOverallModelSoFar,addingBreakPointsImproves_cAIC);

Step 84.Go to step 28;
